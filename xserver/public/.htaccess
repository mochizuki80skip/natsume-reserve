# 接骨院 WEB予約システム（Xserver 用）
# 実在するファイル（画像・JS・CSS）はそのまま返し、それ以外はすべて index.php に渡す
# ※ Xserver ではキャッシュ・ヘッダー系の指定を書くと 500 エラーになったため、振り分けだけにしている
#   （セキュリティ用のヘッダーとキャッシュ無効化は index.php 側で付ける）
RewriteEngine On
RewriteBase /
# ここで RewriteEngine On としているので、親フォルダ（WordPress の public_html）の書き換え規則は引き継がれない

# app フォルダを public_html の中に置いた場合でも外から読めないようにする
RewriteRule ^app/ - [F,L]

# トップ（/）は必ず index.php に渡す。フォルダ扱いで index.html が直接返されると、
# 設置の種類（APP_MODE）が画面に渡らず、SNS 投稿管理でも予約システムのトップが出てしまうため
RewriteRule ^$ index.php [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]
