# PostgreSQL 接続文字列（Supabase / Neon / Vercel Postgres など）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking"
# セッション署名用の秘密鍵（openssl rand -base64 32 で生成）
SESSION_SECRET="change-me-to-a-long-random-string"
# 本部アカウントの初期パスワード（seed 実行時に使用）
HQ_PASSWORD="change-me"
# SMS 送信（Twilio）。未設定の場合は送信せずログに出力するだけ
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Vercel Cron からの呼び出しを保護するトークン
CRON_SECRET="change-me"
