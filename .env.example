# PostgreSQL 接続文字列。Supabase の場合:
#   DATABASE_URL = Transaction pooler (ポート 6543) の URI + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = Direct connection (ポート 5432) の URI（db push 用）
# ローカルなど通常の PostgreSQL では両方に同じ値を入れる
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/booking"
# セッション署名用の秘密鍵（openssl rand -base64 32 で生成）
SESSION_SECRET="change-me-to-a-long-random-string"
# 本部アカウントの初期パスワード（seed 実行時に使用）
HQ_PASSWORD="change-me"
# SMS 送信（Twilio、有料）。3 つとも未設定なら SMS は送らない（顧客画面にも SMS の案内を出さない）
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Vercel Cron からの呼び出しを保護するトークン
CRON_SECRET="change-me"
